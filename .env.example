PORT=8080
DATABASE_URL=postgresql://user:pass@localhost:5432/zynd
# Max Postgres connections held by this process (default 4; keeps memory low)
DB_POOL_MAX=4
# AgentDNS base URL (registry, search, heartbeat WebSocket)
AGENTDNS_URL=https://dns01.zynd.ai
# Public base URL of this Gateway; entity_url is {PUBLIC_URL}/a/{entityId}
PUBLIC_URL=https://gw.zynd.ai
# HS256 secret shared with the dashboard for Session JWTs on /internal/v1/* (min 32 chars).
# Generate with: openssl rand -hex 32
SESSION_JWT_SECRET=
# The dashboard's PKI_ENCRYPTION_KEY: 64 hex chars (32 bytes) AES-256-GCM key. Decrypts
# developer_keys.private_key_enc and encrypts webhook secrets. Required whenever DATABASE_URL is set.
PKI_ENCRYPTION_KEY=
# Heartbeat only once a listing has a webhook bound (default true). false = heartbeat as soon as registered.
HEARTBEAT_REQUIRES_WEBHOOK=true
# --- x402 (M2). Defaults are Base Sepolia test USDC. ---
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_ASSET_NAME=USDC
X402_ASSET_VERSION=2
X402_ASSET_DECIMALS=6
# Default price of one inbound call in USD, for listings without their own price.
# Empty = payment optional (verified only when a proof is sent). A listing price of 0 is always free.
X402_INBOUND_PRICE_USD=
# Ceiling for one outbound payment when the n8n node sends no maxPaymentUsd.
X402_DEFAULT_MAX_PAYMENT_USD=0.10
# Accept webhook URLs on loopback/private networks (default: true outside production, false in production).
WEBHOOK_ALLOW_PRIVATE=
