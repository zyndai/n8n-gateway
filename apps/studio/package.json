{
  "name": "zynd-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Zynd Studio: a chat-to-agent app for people who are not developers. Runs on the Gateway and n8n.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "node .next/standalone/apps/studio/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:builder": "tsx --env-file=.env scripts/eval-builder.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next": "^16.2.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.57.20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
