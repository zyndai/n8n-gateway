# Zynd Studio settings. Locally: copy to .env.local. On the server: /opt/zynd-n8n-gateway/studio.env (deploy.sh reads it;
# without that file the deploy skips Studio). docker compose reads the same names from the repo's .env.

# --- Preview ---
# 1 = every page shows sample data and nobody signs in. For the look sign-off and local work. Unset for real use.
STUDIO_PREVIEW=
# The address people use to reach Studio (the https subdomain). Used for redirects behind the reverse proxy.
STUDIO_PUBLIC_URL=http://localhost:3100

# --- Sign-in: the zynd.ai Supabase project (Google only) ---
# Add {STUDIO_PUBLIC_URL}/auth/callback to the project's allowed redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Gateway ---
GATEWAY_URL=https://gateway.thenorthbound.agency
# Same value as the Gateway's SESSION_JWT_SECRET (32+ characters). Also keys Studio's own cookie (derived, never used directly).
SESSION_JWT_SECRET=
# Same value as the Gateway's STUDIO_SERVICE_TOKEN (32+ characters). Only for POST /internal/v1/provision.
STUDIO_SERVICE_TOKEN=
# What n8n puts in each user's Zynd credential as the Gateway address. Defaults to GATEWAY_URL.
N8N_GATEWAY_URL=

# --- n8n (the owner's instance) ---
# REST API key (Settings > n8n API): creates the Zynd credential for each user.
N8N_API_URL=https://n8n.thenorthbound.agency
N8N_API_KEY=
# Instance-level MCP access token (Settings > Instance-level MCP): finds credentials now, builds agents later.
N8N_MCP_URL=https://n8n.thenorthbound.agency/mcp-server/http
N8N_MCP_TOKEN=

# --- Agents ---
# Spend cap, in USD, on each user's API key.
AGENT_KEY_SPEND_CAP_USD=5

# --- Agent builder (S2) and agents (S3) ---
# The platform's OpenAI key and the model that drives the builder chat. Both required for the builder; without them
# Create agent shows "not switched on yet".
OPENAI_API_KEY=
OPENAI_MODEL=
# The model every agent runs on inside n8n (default gpt-5.4-mini). An agent that names any other model is refused.
AGENT_MODEL=
# The id of the platform's "OpenAI account" credential in n8n (Credentials > open it: the id is in the address).
N8N_OPENAI_CREDENTIAL_ID=
# The registry searched for helpers (no key needed). Default https://zns01.zynd.ai
AGENTDNS_URL=
# The most one helper or data-source call may cost, in USD (default 0.25).
AGENT_MAX_CALL_USD=
# AirnodeHub data sources the builder may give an agent: a JSON array, one entry per operation. Empty = none.
# Example: [{"name":"Briefpixel news","listingUrl":"https://airnode-briefpixel.fly.dev/","operation":"listArticles","what":"Recent news articles about a company.","maxPriceUsd":"0.01","fields":"q, limit"}]
AIRNODE_SOURCES=

# --- Starter credit (S2.1) ---
# The platform wallet that sends each new agent a little test aUSD. Unset = agents are created without credit.
# It needs test aUSD and some Base Sepolia ETH for gas. Keep this file mode 600.
TREASURY_PRIVATE_KEY=
# JSON-RPC node for the transfer (default the public Base Sepolia node).
X402_RPC_URL=
# The token agents pay in (default aUSD on Base Sepolia), its decimals and the chain id.
STARTER_CREDIT_ASSET=
STARTER_CREDIT_DECIMALS=6
STARTER_CREDIT_CHAIN_ID=84532
# How much each new agent gets, and how many of a person's first agents get it.
STARTER_CREDIT_USD=1
STARTER_CREDIT_MAX_AGENTS=3
